+// One dock per native window, with genuine side-panel extension bindings.
+// The native shell reserves its rectangle; this widget never creates a browser
+// window, tab, toolbar or remotely controllable native surface.
+class XenonSidePanel final : public content::WebContentsObserver,
+    public extensions::ExtensionRegistryObserver,
+    public extensions::ExtensionHostRegistry::Observer,
+    public extensions::SidePanelService::Observer {
+ public:
+  XenonSidePanel(int owner, const extensions::Extension& extension,
+                std::optional<int> contextual, std::string path)
+      : owner_(owner), window_(ActionState().tabs.at(owner).window),
+        profile_(Profile::FromBrowserContext(ActionState().tabs.at(owner).contents->GetBrowserContext())),
+        id_(extension.id()), contextual_(contextual), path_(std::move(path)) {
+    Observe(ActionState().tabs.at(owner).contents.get());
+    auto delegate = std::make_unique<XenonPopupDelegate>(web_contents());
+    delegate_ = delegate.get();
+    host_ = std::make_unique<extensions::ExtensionViewHost>(&extension, profile_,
+        extension.GetResourceURL(path_), extensions::mojom::ViewType::kExtensionSidePanel,
+        std::move(delegate));
+    host_->SetCloseHandler(base::BindOnce([](XenonSidePanel* self, extensions::ExtensionHost*) {
+      self->RetireSoon();
+    }, base::Unretained(this)));
+    registry_.Observe(extensions::ExtensionRegistry::Get(profile_));
+    hosts_.Observe(extensions::ExtensionHostRegistry::Get(profile_));
+    service_.Observe(extensions::SidePanelService::Get(profile_));
+    widget_ = std::make_unique<views::Widget>();
+    views::Widget::InitParams params(views::Widget::InitParams::CLIENT_OWNS_WIDGET,
+                                    views::Widget::InitParams::TYPE_CONTROL);
+    params.parent_widget = window_; params.child = true;
+    params.bounds = gfx::Rect(0,0,320,480);
+    params.native_widget = new views::DesktopNativeWidgetAura(widget_.get());
+    widget_->Init(std::move(params));
+    auto contents = std::make_unique<views::View>();
+    auto* layout = contents->SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kVertical));
+    auto* header = contents->AddChildView(std::make_unique<views::View>());
+    auto* header_layout = header->SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kHorizontal, gfx::Insets(8), 8));
+    auto* title = header->AddChildView(std::make_unique<views::Label>(base::UTF8ToUTF16(extension.name())));
+    header_layout->SetFlexForView(title,1);
+    header->AddChildView(std::make_unique<views::LabelButton>(base::BindRepeating(
+        [](XenonSidePanel* self) { self->RetireSoon(); }, base::Unretained(this)), u"Close"));
+    view_ = contents->AddChildView(std::make_unique<ExtensionViewViews>(profile_,host_.get()));
+    layout->SetFlexForView(view_,1); view_->Init();
+    widget_->SetContentsView(std::move(contents));
+    ActionState().panels[window_] = this;
+    PostMessageW(window_,WM_APP+93,0,0);
+    load_timeout_.Start(FROM_HERE,base::Seconds(15),base::BindOnce(
+        &XenonSidePanel::RetireSoon,base::Unretained(this)));
+  }
+  ~XenonSidePanel() override {
+    weak_factory_.InvalidateWeakPtrs();load_timeout_.Stop();
+    SetAnnounced(false);
+    service_.Reset();hosts_.Reset();registry_.Reset();Observe(nullptr);
+    view_=nullptr;delegate_=nullptr;host_.reset();widget_.reset();
+    PostMessageW(window_,WM_APP+93,0,0);
+  }
+  int owner() const { return owner_; }
+  Profile* profile() const { return profile_; }
+  const std::string& id() const { return id_; }
+  bool contextual() const { return contextual_.has_value(); }
+  std::optional<int> context_id() const { return contextual_; }
+  content::WebContents* popup_contents() const { return host_->host_contents(); }
+  bool VisibleFor(int browser) const { return !closing_ && owner_==browser && (!contextual_ ||
+      (web_contents() && sessions::SessionTabHelper::IdForTab(web_contents()).id()==*contextual_)); }
+  void SetAnnounced(bool open) {
+    if(!service_.IsObserving()){announced_=false;return;}
+    if (announced_==open) return; announced_=open;
+    if(open)extensions::SidePanelService::Get(profile_)->DispatchOnOpenedEvent(id_,ActionState().windows.at(window_),contextual_,path_);
+    else extensions::SidePanelService::Get(profile_)->DispatchOnClosedEvent(id_,ActionState().windows.at(window_),contextual_,path_);
+  }
+  void Select(int browser) {
+    const auto& tab = ActionState().tabs.at(browser);
+    if (tab.contents->GetBrowserContext()!=profile_) {widget_->Hide();SetAnnounced(false);RetireSoon();return;}
+    const int tab_id=sessions::SessionTabHelper::IdForTab(tab.contents.get()).id();
+    if(contextual_ && *contextual_!=tab_id){widget_->Hide();SetAnnounced(false);PostMessageW(window_,WM_APP+93,0,0);return;}
+    owner_=browser;Observe(tab.contents.get());delegate_->SetSource(tab.contents.get());
+    PostMessageW(window_,WM_APP+93,0,0);
+    RefreshOptions();
+  }
+  void Layout(const gfx::Rect& bounds) {
+    if (closing_ || bounds.IsEmpty()) {widget_->Hide();SetAnnounced(false);return;}
+    // DesktopNativeWidgetAura with external parent uses physical child bounds.
+    SetWindowPos(widget_->GetNativeWindow()->GetHost()->GetAcceleratedWidget(),nullptr,
+        bounds.x(),bounds.y(),bounds.width(),bounds.height(),SWP_NOACTIVATE|SWP_NOZORDER);
+    if (loaded_ && VisibleFor(ActionState().current)) {widget_->ShowInactive();SetAnnounced(true);}
+  }
+  void RetireSoon() {
+    if(closing_)return;closing_=true;
+    if(widget_)widget_->Hide();SetAnnounced(false);
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE,base::BindOnce(
+        [](base::WeakPtr<XenonSidePanel> self){if(self)CloseSidePanel(self->window_);},weak_factory_.GetWeakPtr()));
+  }
+  void RefreshOptions() {
+    if(closing_)return;
+    const auto* extension=extensions::ExtensionRegistry::Get(profile_)->enabled_extensions().GetByID(id_);
+    if(!extension){RetireSoon();return;}
+    const auto options=extensions::SidePanelService::Get(profile_)->GetOptions(*extension,
+        contextual_ ? contextual_ : std::optional<int>(sessions::SessionTabHelper::IdForTab(web_contents()).id()));
+    if(!options.enabled.value_or(false)||!options.path){RetireSoon();return;}
+    const auto url=extension->GetResourceURL(*options.path);
+    if(!url.SchemeIs(extensions::kExtensionScheme)||url.host()!=id_){RetireSoon();return;}
+    if(path_!=*options.path){path_=*options.path;host_->host_contents()->GetController().LoadURL(url,content::Referrer(),ui::PAGE_TRANSITION_AUTO_TOPLEVEL,std::string());}
+  }
+  void OnPanelOptionsChanged(const std::string& id,const extensions::api::side_panel::PanelOptions&) override {
+    if(id==id_)base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE,base::BindOnce(
+        [](base::WeakPtr<XenonSidePanel> self){if(self)self->RefreshOptions();},weak_factory_.GetWeakPtr()));
+  }
+  void OnSidePanelServiceShutdown() override {service_.Reset();RetireSoon();}
+  void OnExtensionUnloaded(content::BrowserContext*,const extensions::Extension* extension,
+      extensions::UnloadedExtensionReason) override {
+    if(extension->id()==id_){if(view_&&view_->parent())view_->parent()->RemoveChildViewT(view_.ExtractAsDangling());RetireSoon();}
+  }
+  void OnExtensionHostCompletedFirstLoad(content::BrowserContext*,extensions::ExtensionHost* host) override {
+    if(host==host_.get()&&!closing_){loaded_=true;load_timeout_.Stop();PostMessageW(window_,WM_APP+93,0,0);}
+  }
+  void OnExtensionHostRenderProcessGone(content::BrowserContext*,extensions::ExtensionHost* host) override {
+    if(host==host_.get())RetireSoon();
+  }
+  void WebContentsDestroyed() override {RetireSoon();}
+ private:
+  int owner_; HWND window_; raw_ptr<Profile> profile_; std::string id_;
+  std::optional<int> contextual_; std::string path_;
+  bool closing_=false,loaded_=false,announced_=false;
+  std::unique_ptr<extensions::ExtensionViewHost> host_;
+  std::unique_ptr<views::Widget> widget_;
+  raw_ptr<ExtensionViewViews> view_=nullptr;
+  raw_ptr<XenonPopupDelegate> delegate_=nullptr;
+  base::OneShotTimer load_timeout_;
+  base::ScopedObservation<extensions::ExtensionRegistry,extensions::ExtensionRegistryObserver> registry_{this};
+  base::ScopedObservation<extensions::ExtensionHostRegistry,extensions::ExtensionHostRegistry::Observer> hosts_{this};
+  base::ScopedObservation<extensions::SidePanelService,extensions::SidePanelService::Observer> service_{this};
+  base::WeakPtrFactory<XenonSidePanel> weak_factory_{this};
+};
+void CloseSidePanel(HWND window) {
+  auto& panels=ActionState().panels;
+  if(window){auto it=panels.find(window);if(it!=panels.end()){auto* panel=it->second;panels.erase(it);delete panel;}}
+  else while(!panels.empty())CloseSidePanel(panels.begin()->first);
+}
+void SelectSidePanel(int browser) {
+  const auto& tab=ActionState().tabs.at(browser);
+  if(auto it=ActionState().panels.find(tab.window);it!=ActionState().panels.end())it->second->Select(browser);
+}
+
+void CloseActionPopup(int browser) {
+  auto& state = ActionState();
+  if (browser) {
+    auto it = state.popups.find(browser);
+    if (it != state.popups.end()) {
+      auto* popup = it->second; state.popups.erase(it); popup->Shutdown(); delete popup;
+    }
+  } else {
+    while (!state.popups.empty()) CloseActionPopup(state.popups.begin()->first);
+  }
+}
+}  // namespace
