+extern "C" __declspec(dllexport) void cef_xenon_extension_guard_v1(int (*guard)(int)) {
+  if(content::BrowserThread::CurrentlyOn(content::BrowserThread::UI))cef::ActionState().guard=guard;
+}
+
+// ABI v1: 0=version, 1=register, 2=select, 3=unregister, 4=invoke action,
+// 5=close popup(s), 6=count popups. IDs and rectangles come from native chrome.
+// Result: version=1; invoke=1 dispatched, 2 no action, -1 refused, -2 blocked,
+// -3 unsupported side panel. Other commands return 1, count returns its size.
+extern "C" __declspec(dllexport) int cef_xenon_extension_action_v1(
+    int command, int browser_id, const char* extension_id,
+    int x, int y, int width, int height) {
+  if (!content::BrowserThread::CurrentlyOn(content::BrowserThread::UI)) return -1;
+  auto& state = cef::ActionState();
+  if (command == 0) return 1;
+  if (command == 18) return 1 | (base::FeatureList::IsEnabled(extensions_features::kExtensionsMenuAccessControl) ? 2 : 0);
+  if (command == 5) { cef::CloseActionPopup(browser_id); return 1; }
+  if (command == 6) return browser_id ? state.popups.count(browser_id) : state.popups.size();
+  if(command==24){
+    cef::CloseActionPopup(browser_id);
+    if(browser_id){if(auto it=state.tabs.find(browser_id);it!=state.tabs.end())cef::CloseSidePanel(it->second.window);}
+    else cef::CloseSidePanel(nullptr);
+    return 1;
+  }
+  if(command==26)return state.panels.size();
+  if (command == 16) {
+    cef::CloseActionPopup(0);
+    cef::CloseSidePanel(nullptr);
+    if (auto it = state.tabs.find(state.current); it != state.tabs.end()) it->second.active = false;
+    state.current = 0; return 1;
+  }
+  if (command == 3) {
+    for(auto it=state.panels.begin();it!=state.panels.end();) {
+      const auto window=it->first;++it;
+      if(state.panels.at(window)->owner()==browser_id)cef::CloseSidePanel(window);
+    }
+    cef::CloseActionPopup(browser_id); state.tabs.erase(browser_id);
+    if (state.current == browser_id) state.current = 0;
+    for (auto it = state.windows.begin(); it != state.windows.end();) {
+      const auto window = it->first;
+      if (std::ranges::none_of(state.tabs, [window](const auto& tab) { return tab.second.window == window; })) it = state.windows.erase(it);
+      else ++it;
+    }
+    return 1;
+  }
+  auto browser = CefBrowserHostBase::GetBrowserForBrowserId(browser_id);
+  if (!browser || !browser->IsAlloyStyle() || browser->WillBeDestroyed()) return -1;
+  auto* source = browser->GetWebContents();
+  auto* profile = Profile::FromBrowserContext(source->GetBrowserContext());
+  if (profile->IsOffTheRecord()) return -1;
+  if (command == 1 || command == 2) {
+    HWND owner = GetAncestor(browser->GetWindowHandle(), GA_ROOT);
+    if (!owner) return -1;
+    auto [window, inserted] = state.windows.try_emplace(owner, state.next_window);
+    if (inserted) ++state.next_window;
+    auto& tab = state.tabs[browser_id];
+    if(tab.window && tab.window!=owner){cef::CloseSidePanel(tab.window);cef::CloseActionPopup(browser_id);tab.active=false;}
+    tab.contents = source->GetWeakPtr(); tab.window = owner; tab.window_id = window->second;
+    if (command == 2) {
+      const bool changed=!tab.active;
+      if (state.current != browser_id) cef::CloseActionPopup(0);
+      for (auto& [id, other] : state.tabs)
+        if (other.window == owner) other.active = id == browser_id;
+      state.current = browser_id;
+      cef::SelectSidePanel(browser_id);
+      if(changed){
+        base::DictValue info;info.Set("tabId",sessions::SessionTabHelper::IdForTab(source).id());info.Set("windowId",tab.window_id);
+        base::ListValue args;args.Append(std::move(info));
+        extensions::EventRouter::Get(profile)->BroadcastEvent(std::make_unique<extensions::Event>(
+            extensions::events::TABS_ON_ACTIVATED,extensions::api::tabs::OnActivated::kEventName,std::move(args),profile));
+      }
+    }
+    return 1;
+  }
+  if(command>=19&&command<=22){
+    const auto it=state.tabs.find(browser_id);if(it==state.tabs.end())return -1;
+    auto panel=state.panels.find(it->second.window);
+    if(command==19){it->second.anchor=display::win::GetScreenWin()->ScreenToDIPRect(it->second.window,gfx::Rect(x,y,width,height));return 1;}
+    if(command==20)return panel!=state.panels.end()&&panel->second->VisibleFor(browser_id)?1:0;
+    if(command==21){if(panel!=state.panels.end())cef::CloseSidePanel(it->second.window);return 1;}
+    if(panel!=state.panels.end()&&panel->second->VisibleFor(browser_id))panel->second->Layout(gfx::Rect(x,y,width,height));
+    return 1;
+  }
+  if ((command != 4 && command != 7 && command != 25 && (command < 8 || command > 17)) || !state.tabs.contains(browser_id) || !extension_id) return -1;
+  if (command != 17 && (!state.tabs[browser_id].active || state.current != browser_id ||
+      width < 1 || height < 1 || width > 4096 || height > 4096)) return -1;
+  const auto url = source->GetLastCommittedURL();
+  auto* permissions = extensions::PermissionsManager::Get(profile);
+  if (command == 10 || command == 11) {
+    if (!url.SchemeIsHTTPOrHTTPS() || !base::FeatureList::IsEnabled(extensions_features::kExtensionsMenuAccessControl)) return -1;
+    cef::CloseActionPopup(0);
+    if(command==10)cef::CloseSidePanel(state.tabs.at(browser_id).window);
+    permissions->UpdateUserSiteSetting(url::Origin::Create(url), command == 10 ?
+      extensions::PermissionsManager::UserSiteSetting::kBlockAllExtensions :
+      extensions::PermissionsManager::UserSiteSetting::kCustomizeByExtension);
+    return 1;
+  }
+  const std::string id(extension_id, strnlen(extension_id, 33));
+  if (id.size() != 32 || !std::ranges::all_of(id, [](char c) { return c >= 'a' && c <= 'p'; })) return -1;
+  const auto* extension = extensions::ExtensionRegistry::Get(profile)->enabled_extensions().GetByID(id);
+  if (!extension) return -1;
+  if (command == 17) {
+    const auto* action = extensions::ExtensionActionManager::Get(profile)->GetExtensionAction(*extension);
+    const int tab = sessions::SessionTabHelper::IdForTab(source).id();
+    int flags = action ? 1 : 0;
+    if (action && action->GetIsVisible(tab)) flags |= 2;
+    if (action && action->HasPopup(tab)) flags |= 4;
+    const auto access = extension->permissions_data()->GetPageAccess(url, tab, nullptr);
+    if (access == extensions::PermissionsData::PageAccess::kAllowed) flags |= 8;
+    if (access == extensions::PermissionsData::PageAccess::kWithheld ||
+        (extension->permissions_data()->HasAPIPermission("activeTab") &&
+         !extension->permissions_data()->IsRestrictedUrl(url,nullptr))) flags |= 16;
+    if (permissions->GetUserSiteSetting(url::Origin::Create(url)) ==
+        extensions::PermissionsManager::UserSiteSetting::kBlockAllExtensions) flags |= 32;
+    if (permissions->CanAffectExtension(*extension)) {
+      using Access = extensions::PermissionsManager::UserSiteAccess;
+      if (permissions->CanUserSelectSiteAccess(*extension,url,Access::kOnClick)) flags |= 128;
+      if (permissions->CanUserSelectSiteAccess(*extension,url,Access::kOnSite)) flags |= 256;
+      if (permissions->CanUserSelectSiteAccess(*extension,url,Access::kOnAllSites)) flags |= 512;
+    }
+    const auto* toolbar = ToolbarActionsModel::Get(profile);
+    if (toolbar && toolbar->action_ids().contains(id) && !toolbar->IsActionForcePinned(id)) flags |= 1024;
+    const auto panel=extensions::SidePanelService::Get(profile)->GetOptions(*extension,tab);
+    if(panel.path&&panel.enabled.value_or(false))flags|=2048;
+    return flags;
+  }
+  if(command==25){
+    auto panel=state.panels.find(state.tabs.at(browser_id).window);
+    if(panel!=state.panels.end()&&panel->second->id()==id&&panel->second->VisibleFor(browser_id)){
+      cef::CloseSidePanel(panel->first);return 1;
+    }
+    const int tab=sessions::SessionTabHelper::IdForTab(source).id();
+    return cef::SetAlloyExtensionSidePanel(profile,*extension,tab,std::nullopt,true).has_value()?1:-1;
+  }
+  if (command == 8 || command == 9) {
+    auto* toolbar = ToolbarActionsModel::Get(profile);
+    if (!toolbar || !toolbar->action_ids().contains(id) || toolbar->IsActionForcePinned(id)) return -1;
+    if (toolbar->IsActionPinned(id) != (command == 8)) toolbar->SetActionVisibility(id, command == 8);
+    return toolbar->IsActionPinned(id) == (command == 8) ? 1 : -1;
+  }
+  if (command >= 12 && command <= 14) {
+    if (!url.SchemeIsHTTPOrHTTPS() || !permissions->CanAffectExtension(*extension)) return -1;
+    using Access = extensions::PermissionsManager::UserSiteAccess;
+    const auto access = command == 12 ? Access::kOnClick : command == 13 ? Access::kOnSite : Access::kOnAllSites;
+    if (!permissions->CanUserSelectSiteAccess(*extension,url,access)) return -1;
+    cef::CloseActionPopup(0);
+    extensions::ScriptingPermissionsModifier modifier(profile, extension);
+    if (command == 14) modifier.SetWithholdHostPermissions(false);
+    else {
+      if (permissions->HasBroadGrantedHostPermissions(*extension)) modifier.RemoveBroadGrantedHostPermissions();
+      if (!permissions->HasWithheldHostPermissions(*extension)) {
+        modifier.SetWithholdHostPermissions(true); modifier.RemoveAllGrantedHostPermissions();
+      }
+      if (command == 13) modifier.GrantHostPermission(url);
+      else {
+        URLPattern pattern(extensions::Extension::kValidHostPermissionSchemes);
+        if (pattern.Parse(url::Origin::Create(url).Serialize() + "/*") != URLPattern::ParseResult::kSuccess) return -1;
+        modifier.RemoveHostPermissions(pattern, base::DoNothing());
+        if (auto* granter = extensions::ActiveTabPermissionGranter::FromWebContents(source))
+          granter->ClearActiveExtensionAndNotify(id);
+      }
+    }
+    return 1;
+  }
+  if (command == 15) {
+    cef::CloseActionPopup(0); std::u16string error;
+    return extensions::ExtensionRegistrar::Get(profile)->UninstallExtension(
+      id, extensions::UNINSTALL_REASON_USER_INITIATED, &error) ? 1 : -1;
+  }
+  if (!url.SchemeIsHTTPOrHTTPS() ||
+      extensions::PermissionsManager::Get(profile)->GetUserSiteSetting(url::Origin::Create(url)) ==
+          extensions::PermissionsManager::UserSiteSetting::kBlockAllExtensions) return -2;
+  auto* action = extensions::ExtensionActionManager::Get(profile)->GetExtensionAction(*extension);
+  if (!action) return 2;
+  auto* runner = extensions::ExtensionActionRunner::GetForWebContents(source);
+  if (!runner) return -1;
+  const bool needs_reload = extensions::SitePermissionsHelper(profile).PageNeedsRefreshToRun(
+      runner->GetBlockedActions(extension->id()));
+  if (needs_reload && command != 7) return -4;
+  cef::CloseActionPopup(0);
+  const auto outcome = runner->RunAction(extension, true);
+  if (needs_reload) {
+    source->GetController().Reload(content::ReloadType::NORMAL, true);
+    return 1;
+  }
+  if (outcome == extensions::ExtensionAction::ShowAction::kToggleSidePanel) {
+    auto panel=state.panels.find(state.tabs.at(browser_id).window);
+    if(panel!=state.panels.end()&&panel->second->id()==id&&panel->second->VisibleFor(browser_id)){
+      cef::CloseSidePanel(panel->first);return 1;
+    }
+    return cef::SetAlloyExtensionSidePanel(profile,*extension,
+        sessions::SessionTabHelper::IdForTab(source).id(),std::nullopt,true).has_value()?1:-1;
+  }
+  if (outcome != extensions::ExtensionAction::ShowAction::kShowPopup) return 1;
+  const auto popup_url = action->GetPopupUrl(sessions::SessionTabHelper::IdForTab(source).id());
+  if (!popup_url.is_valid() || popup_url.host() != id || !popup_url.SchemeIs(extensions::kExtensionScheme)) return -1;
+  const auto anchor = display::win::GetScreenWin()->ScreenToDIPRect(
+      state.tabs[browser_id].window, gfx::Rect(x, y, width, height));
+  auto* popup = new cef::XenonActionPopup(browser_id, source, *extension, popup_url, anchor);
+  popup->ShowHost();
+  return 1;
+}
