+class XenonActionPopup final
+    : public views::BubbleDialogDelegate,
+      public ExtensionViewViews::Container,
+      public content::WebContentsObserver,
+      public extensions::ExtensionRegistryObserver,
+      public extensions::ExtensionHostRegistry::Observer {
+ public:
+  XenonActionPopup(int owner, content::WebContents* source,
+                   const extensions::Extension& extension, const GURL& url,
+                   const gfx::Rect& anchor,
+                   base::OnceCallback<void(extensions::ExtensionHost*)> ready = {})
+      : views::BubbleDialogDelegate(nullptr, views::BubbleBorder::TOP_RIGHT,
+                                    views::BubbleBorder::STANDARD_SHADOW, true),
+        content::WebContentsObserver(source), owner_(owner),
+        ready_(std::move(ready)), source_(source->GetWeakPtr()) {
+    SetButtons(static_cast<int>(ui::mojom::DialogButton::kNone));
+    set_margins(gfx::Insets());
+    SetAnchorRect(anchor);
+    set_parent_window(source->GetNativeView());
+    set_close_on_deactivate(true);
+    SetTitle(base::UTF8ToUTF16(extension.name()));
+    contents_ = SetContentsView(std::make_unique<XenonPopupContent>(base::BindRepeating(
+        [](XenonActionPopup* self) { if (self->GetWidget()) self->SizeToContents(); },
+        base::Unretained(this))));
+    host_ = std::make_unique<extensions::ExtensionViewHost>(
+        &extension, source->GetBrowserContext(), url,
+        extensions::mojom::ViewType::kExtensionPopup,
+        std::make_unique<XenonPopupDelegate>(source));
+    host_->SetCloseHandler(base::BindOnce(
+        [](XenonActionPopup* self, extensions::ExtensionHost*) { self->Close(); },
+        base::Unretained(this)));
+    registry_.Observe(extensions::ExtensionRegistry::Get(source->GetBrowserContext()));
+    hosts_.Observe(extensions::ExtensionHostRegistry::Get(source->GetBrowserContext()));
+    view_ = contents_->AddChildView(std::make_unique<ExtensionViewViews>(
+        Profile::FromBrowserContext(source->GetBrowserContext()), host_.get()));
+    view_->SetContainer(this);
+    view_->Init();
+    ActionState().popups[owner] = this;
+    load_timeout_.Start(FROM_HERE, base::Seconds(15), base::BindOnce(
+        [](XenonActionPopup* self) { self->Close(); }, base::Unretained(this)));
+  }
+  ~XenonActionPopup() override {
+    Shutdown();
+    auto& popups = ActionState().popups;
+    if (auto it = popups.find(owner_); it != popups.end() && it->second == this)
+      popups.erase(it);
+  }
+  void ShowHost() {
+    widget_ = views::BubbleDialogDelegate::CreateBubble(this, base::BindOnce(
+        [](base::WeakPtr<XenonActionPopup> self, views::Widget::ClosedReason) {
+          if (self) self->RetireSoon();
+        }, weak_factory_.GetWeakPtr()));
+  }
+  void RetireSoon() {
+    closing_ = true;
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE, base::BindOnce(
+        [](base::WeakPtr<XenonActionPopup> self) { if (self) CloseActionPopup(self->owner_); },
+        weak_factory_.GetWeakPtr()));
+  }
+  void Shutdown() {
+    closing_ = true; weak_factory_.InvalidateWeakPtrs(); load_timeout_.Stop();
+    hosts_.Reset(); registry_.Reset(); Observe(nullptr);
+    if (ready_) std::move(ready_).Run(nullptr);
+    view_ = nullptr; host_.reset(); contents_ = nullptr; widget_.reset();
+  }
+  void Close() { closing_ = true; if (widget_) widget_->Close(); else RetireSoon(); }
+  void OnWidgetClosing(views::Widget*) override { closing_ = true; load_timeout_.Stop(); }
+  void OnBeforeBubbleWidgetInit(views::Widget::InitParams* params, views::Widget* widget) const override {
+    // Alloy's Aura root covers only the website, not Xenon's Win32 chrome.
+    // Use a desktop bubble for native activation, dismissal and unclipped bounds.
+    params->native_widget = new views::DesktopNativeWidgetAura(widget);
+  }
+  content::WebContents* source() const { return source_.get(); }
+  content::WebContents* popup_contents() const { return host_->host_contents(); }
+  gfx::Size GetMinBounds() override { return {25, 25}; }
+  gfx::Size GetMaxBounds() override {
+    gfx::Size size(800,600);
+    const auto anchor = GetAnchorRect();
+    const auto screen = display::Screen::Get()->GetDisplayNearestPoint(anchor.CenterPoint()).work_area();
+    gfx::Size available;
+    for (const auto arrow : {views::BubbleBorder::TOP_LEFT, views::BubbleBorder::TOP_RIGHT,
+                             views::BubbleBorder::BOTTOM_LEFT, views::BubbleBorder::BOTTOM_RIGHT})
+      available.SetToMax(views::BubbleDialogDelegate::GetAvailableSpaceToPlaceBubble(arrow,anchor,screen));
+    size.SetToMin(available);
+    size.SetToMax({25,25}); return size;
+  }
+  views::View* GetInitiallyFocusedView() override { return view_; }
+  void OnExtensionHostCompletedFirstLoad(content::BrowserContext*,
+                                          extensions::ExtensionHost* host) override {
+    if (host == host_.get() && !closing_ && source_ && GetWidget()) {
+      if(!SurfaceAllowed(owner_)){Close();return;}
+      load_timeout_.Stop();
+      SizeToContents(); GetWidget()->Show(); host_->host_contents()->Focus();
+      if (ready_) std::move(ready_).Run(host_.get());
+    }
+  }
+  void OnExtensionHostRenderProcessGone(content::BrowserContext*,
+                                        extensions::ExtensionHost* host) override {
+    if (host == host_.get()) Close();
+  }
+  void OnExtensionUnloaded(content::BrowserContext*,
+                           const extensions::Extension* extension,
+                           extensions::UnloadedExtensionReason) override {
+    if (extension->id() == host_->extension_id()) {
+      if (view_) contents_->RemoveChildViewT(view_.ExtractAsDangling());
+      Close();
+    }
+  }
+  void DidStartNavigation(content::NavigationHandle* navigation) override {
+    if (navigation->IsInPrimaryMainFrame()) Close();
+  }
+  void WebContentsDestroyed() override { source_.reset(); Close(); }
+ private:
+  int owner_;
+  bool closing_ = false;
+  base::OnceCallback<void(extensions::ExtensionHost*)> ready_;
+  base::WeakPtr<content::WebContents> source_;
+  std::unique_ptr<extensions::ExtensionViewHost> host_;
+  std::unique_ptr<views::Widget> widget_;
+  raw_ptr<XenonPopupContent> contents_ = nullptr;
+  raw_ptr<ExtensionViewViews> view_ = nullptr;
+  base::OneShotTimer load_timeout_;
+  base::ScopedObservation<extensions::ExtensionRegistry,
+                          extensions::ExtensionRegistryObserver> registry_{this};
+  base::ScopedObservation<extensions::ExtensionHostRegistry,
+                          extensions::ExtensionHostRegistry::Observer> hosts_{this};
+  base::WeakPtrFactory<XenonActionPopup> weak_factory_{this};
+};
