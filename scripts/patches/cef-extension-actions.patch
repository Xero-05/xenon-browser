+std::vector<AlloyExtensionTab> GetAlloyExtensionTabs(
+    Profile* profile, content::WebContents* caller) {
+  std::vector<AlloyExtensionTab> result;
+  auto& state = ActionState();
+  int current = state.current;
+  for (const auto& [id, popup] : state.popups)
+    if (caller == popup->popup_contents()) { current = id; break; }
+  for (const auto& [window, panel] : state.panels)
+    if (caller == panel->popup_contents()) { current = panel->owner(); break; }
+  const auto selected = state.tabs.find(current);
+  const int window = selected == state.tabs.end() ? 0 : selected->second.window_id;
+  std::map<int, int> indexes;
+  for (const auto& [id, tab] : state.tabs) {
+    auto* contents = tab.contents.get();
+    if (!contents || contents->GetBrowserContext() != profile || profile->IsOffTheRecord())
+      continue;
+    result.push_back({contents, tab.window_id, indexes[tab.window_id]++, tab.active,
+                      tab.window_id == window});
+  }
+  return result;
+}
+
+bool GetAlloyExtensionTabState(content::WebContents* contents,
+                               int* window, int* index, bool* active) {
+  if (!contents) return false;
+  for (const auto& tab : GetAlloyExtensionTabs(
+           Profile::FromBrowserContext(contents->GetBrowserContext()), nullptr)) {
+    if (tab.contents == contents) {
+      *window = tab.window_id; *index = tab.index; *active = tab.active; return true;
+    }
+  }
+  return false;
+}
+
+bool HasAlloyExtensionTabs(Profile* profile) {
+  return !GetAlloyExtensionTabs(profile,nullptr).empty();
+}
+namespace {
+XenonExtensionTab* ResolveSurfaceTab(Profile* profile,std::optional<int> tab_id,
+                                    std::optional<int> window_id,int* browser) {
+  auto& state=ActionState();
+  for(auto& [id,tab]:state.tabs){
+    if(!tab.contents||tab.contents->GetBrowserContext()!=profile||profile->IsOffTheRecord())continue;
+    if(tab_id && sessions::SessionTabHelper::IdForTab(tab.contents.get()).id()!=*tab_id)continue;
+    if(window_id && *window_id!=-2 && tab.window_id!=*window_id)continue;
+    if(!tab_id && (!tab.active || (window_id.value_or(-2)==-2 && id!=state.current)))continue;
+    *browser=id;return &tab;
+  }
+  return nullptr;
+}
+bool SurfaceAllowed(int browser) {
+  const auto& state=ActionState();
+  const auto it=state.tabs.find(browser);
+  return it!=state.tabs.end()&&it->second.active&&browser==state.current&&state.guard&&state.guard(browser)&&
+      IsWindowEnabled(it->second.window)&&GetAncestor(GetForegroundWindow(),GA_ROOTOWNER)==GetAncestor(it->second.window,GA_ROOTOWNER);
+}
+}
+bool OpenAlloyExtensionPopup(Profile* profile,const extensions::Extension& extension,
+    int window_id,base::OnceCallback<void(extensions::ExtensionHost*)> callback,std::string* error) {
+  int browser=0;auto* tab=ResolveSurfaceTab(profile,std::nullopt,window_id,&browser);
+  auto fail=[&](const char* message){*error=message;return false;};
+  if(!tab||!SurfaceAllowed(browser))return fail("No eligible active Xenon window.");
+  if(!extensions::ExtensionRegistry::Get(profile)->enabled_extensions().Contains(extension.id()))return fail("Extension is not enabled.");
+  if(!ActionState().popups.empty())return fail("An extension popup is already open.");
+  auto* action=extensions::ExtensionActionManager::Get(profile)->GetExtensionAction(extension);
+  const int tab_id=sessions::SessionTabHelper::IdForTab(tab->contents.get()).id();
+  if(!action||!action->GetIsVisible(tab_id)||!action->HasPopup(tab_id)||tab->anchor.IsEmpty())return fail("No active extension popup.");
+  if(extensions::PermissionsManager::Get(profile)->GetUserSiteSetting(url::Origin::Create(tab->contents->GetLastCommittedURL()))==
+      extensions::PermissionsManager::UserSiteSetting::kBlockAllExtensions)return fail("Extensions are blocked on this site.");
+  const auto url=action->GetPopupUrl(tab_id);
+  if(!url.SchemeIs(extensions::kExtensionScheme)||url.host()!=extension.id())return fail("Invalid extension popup.");
+  // An API call is not a toolbar click: never RunAction or grant activeTab.
+  auto* popup=new XenonActionPopup(browser,tab->contents.get(),extension,url,tab->anchor,std::move(callback));
+  popup->ShowHost();return true;
+}
+base::expected<bool,std::string> SetAlloyExtensionSidePanel(Profile* profile,
+    const extensions::Extension& extension,std::optional<int> tab_id,
+    std::optional<int> window_id,bool open) {
+  int browser=0;auto* tab=ResolveSurfaceTab(profile,tab_id,window_id,&browser);
+  if(!tab)return base::unexpected("No matching Xenon tab or window.");
+  auto& state=ActionState();auto existing=state.panels.find(tab->window);
+  if(!open){
+    if(existing==state.panels.end()||existing->second->profile()!=profile||existing->second->id()!=extension.id()||
+        (tab_id ? existing->second->context_id()!=tab_id : existing->second->contextual()))return base::unexpected("No matching open side panel.");
+    CloseSidePanel(tab->window);return true;
+  }
+  if(!SurfaceAllowed(browser))return base::unexpected("No eligible active Xenon window.");
+  if(!extensions::ExtensionRegistry::Get(profile)->enabled_extensions().Contains(extension.id()))return base::unexpected("Extension is not enabled.");
+  if(extensions::PermissionsManager::Get(profile)->GetUserSiteSetting(url::Origin::Create(tab->contents->GetLastCommittedURL()))==
+      extensions::PermissionsManager::UserSiteSetting::kBlockAllExtensions)return base::unexpected("Extensions are blocked on this site.");
+  auto* service=extensions::SidePanelService::Get(profile);
+  const auto options=service->GetOptions(extension,tab_id);
+  if(!options.path||!options.enabled.value_or(false))return base::unexpected("No enabled side panel for this target.");
+  const auto url=extension.GetResourceURL(*options.path);
+  if(!url.SchemeIs(extensions::kExtensionScheme)||url.host()!=extension.id())return base::unexpected("Invalid side panel path.");
+  const auto specific=tab_id?service->GetSpecificOptionsForTab(extension,*tab_id):extensions::api::side_panel::PanelOptions();
+  const auto contextual=specific.path?tab_id:std::nullopt;
+  if(existing!=state.panels.end()&&existing->second->id()==extension.id()&&existing->second->profile()==profile&&
+      existing->second->context_id()==contextual) {existing->second->Select(browser);return true;}
+  CloseActionPopup(0);CloseSidePanel(tab->window);
+  new XenonSidePanel(browser,extension,contextual,*options.path);return true;
+}
