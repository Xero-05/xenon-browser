+// Windowed browsers asked to paint below the display rate, for example a tab
+// covered by another tab in the same window. The page stays visible and keeps
+// its timers; Chromium only sends it fewer BeginFrames. Chromium throttles one
+// set of frame sinks at a single interval, so throttled browsers share the
+// highest requested rate. Child frame sinks such as cross-process iframes
+// inherit the throttle, and video-captured frame sinks are exempt.
+class WindowedFrameRateThrottle : public content::WebContentsObserver {
+ public:
+  // Rates at or above this, and non-positive rates, remove the throttle.
+  static constexpr int kUnthrottledFrameRate = 60;
+
+  WindowedFrameRateThrottle(const WindowedFrameRateThrottle&) = delete;
+  WindowedFrameRateThrottle& operator=(const WindowedFrameRateThrottle&) =
+      delete;
+
+  static void Set(content::WebContents* contents, int frame_rate) {
+    auto& entries = Entries();
+    if (frame_rate <= 0 || frame_rate >= kUnthrottledFrameRate) {
+      // Erasing during WebContentsDestroyed() deletes the calling observer.
+      if (entries.erase(contents)) {
+        Apply();
+      }
+      return;
+    }
+    auto& entry = entries[contents];
+    if (!entry) {
+      entry = base::WrapUnique(new WindowedFrameRateThrottle(contents));
+    }
+    entry->frame_rate_ = frame_rate;
+    Apply();
+  }
+
+ private:
+  using EntryMap =
+      std::map<content::WebContents*,
+               std::unique_ptr<WindowedFrameRateThrottle>>;
+
+  static EntryMap& Entries() {
+    static base::NoDestructor<EntryMap> entries;
+    return *entries;
+  }
+
+  static void Apply() {
+    std::set<content::GlobalRenderFrameHostId> frames;
+    int frame_rate = 0;
+    for (const auto& [contents, entry] : Entries()) {
+      frames.insert(contents->GetPrimaryMainFrame()->GetGlobalId());
+      frame_rate = std::max(frame_rate, entry->frame_rate_);
+    }
+    content::UpdateThrottlingFrameSinks(
+        frames, frame_rate ? base::Hertz(frame_rate) : base::TimeDelta());
+  }
+
+  explicit WindowedFrameRateThrottle(content::WebContents* contents)
+      : content::WebContentsObserver(contents) {}
+
+  // A cross-site navigation can replace the main frame's widget, and with it
+  // the frame sink that Chromium throttles.
+  void RenderFrameHostChanged(content::RenderFrameHost* old_host,
+                              content::RenderFrameHost* new_host) override {
+    if (new_host && new_host->IsInPrimaryMainFrame()) {
+      Apply();
+    }
+  }
+  void PrimaryPageChanged(content::Page& page) override { Apply(); }
+  void WebContentsDestroyed() override { Set(web_contents(), 0); }
+
+  int frame_rate_ = kUnthrottledFrameRate;
+};
+
