{
  "name": "xenon-browser",
  "version": "0.1.0-alpha.10",
  "private": true,
  "description": "A Chromium browser for parallel MCP agents with broker-only handoffs",
  "license": "Apache-2.0",
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "build": "tsc -p adapter/tsconfig.json",
    "typecheck": "tsc -p adapter/tsconfig.json --noEmit",
    "test": "npm run build && node --test adapter/dist/test/*.test.js tests/login-capture-tests.mjs tests/human-autofill-tests.mjs",
    "mcp": "node adapter/dist/src/cli.js",
    "fixtures": "node tests/fixtures/server.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.2.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.2.0",
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
